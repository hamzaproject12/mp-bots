# --- Telegram ---
TELEGRAM_TOKEN=

# --- WhatsApp Cloud API ---
WA_TOKEN=
WA_PHONE_ID=1318151618051403
WA_TEMPLATE=alerte_marche_public
WA_LANG=fr
WA_API_VERSION=v25.0

# --- Execution ---
# once = un passage puis sortie (a utiliser avec le cron Railway)
# loop = boucle infinie 24h/24
RUN_MODE=once
# amorcage = marque tout comme vu SANS rien envoyer (a lancer une fois, puis revenir a once/loop)
SCANNERS=bdc,ao
DATA_PATH=/app/data

# --- Reglages ---
SEUIL_EVENT=2
SEUIL_DEFAUT=1
MAX_SEEN=3000

# --- Site externe (canal "site" du flux hicham) ---
# Vides => canal inexistant, comportement inchange.
SITE_URL=
SITE_TOKEN=
SITE_TIMEOUT=20

# --- Sentinelle : chat Telegram de l'ADMIN (jamais un client). Vide = aucun envoi ---
ADMIN_TELEGRAM=
# Pas deux messages de rupture pour le meme scanner a moins de N heures
SENTINELLE_SILENCE_H=6

# --- Debug (mettre a 1 temporairement) ---
DEBUG_SCORING=0
WA_TEST=0
STARTUP_PING=0
