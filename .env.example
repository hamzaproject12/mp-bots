# --- Telegram ---
TELEGRAM_TOKEN=

# --- WhatsApp Cloud API ---
WA_TOKEN=
WA_PHONE_ID=1318151618051403
WA_TEMPLATE=alerte_marche_public
WA_LANG=fr
WA_API_VERSION=v25.0

# --- Execution ---
# once = un passage puis sortie (a utiliser avec le cron Railway)
# loop = boucle infinie 24h/24
RUN_MODE=once
SCANNERS=bdc,ao
DATA_PATH=/app/data

# --- Reglages ---
SEUIL_EVENT=2
SEUIL_DEFAUT=1
MAX_SEEN=3000

# --- Debug (mettre a 1 temporairement) ---
DEBUG_SCORING=0
WA_TEST=0
STARTUP_PING=0
